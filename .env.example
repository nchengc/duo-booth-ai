# ===== Duo Booth AI 环境变量模板 =====
# 复制为 .env.local(本地)或在部署平台配置;安全扫描会检查密钥不入库

# ---- 站点 ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# 部署时注入,用于 /api/version 验证线上版本(上线纪律 §9)
GIT_COMMIT_SHA=
DEPLOYED_AT=

# ---- 视频供应商(PRD §9:mock 为默认;接入后 VIDEO_PROVIDER=fal|volcengine|replicate) ----
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
# fal 模型端点映射(以 fal 后台实际 ID 为准)
FAL_MODEL_MINI=
FAL_MODEL_FAST=
FAL_MODEL_PRO=
FAL_MODEL_ULTRA=
# 火山引擎 Ark(Seedance 一手渠道):ARK_API_KEY 独立于 VIDEO_API_KEY
ARK_API_KEY=
ARK_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_MINI=
ARK_MODEL_FAST=
ARK_MODEL_PRO=
ARK_MODEL_ULTRA=
# mock 模式渲染耗时(毫秒,本地测试用)
MOCK_RENDER_MS=25000

# ---- 存储后端(json=开发;supabase=生产,需执行 supabase/schema.sql) ----
STORE_BACKEND=json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- 支付(Stripe;无 key 时 checkout 自动落 mock 模式) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 订阅档需在 Stripe Dashboard 建 Price 后填入(Skus.stripePriceId)

# ---- 统计(PVUV.ai 双写;未配置时仅落自家库) ----
PVUV_SITE=
PVUV_INGEST_TOKEN=

# ---- 管理 API(漏斗/实验/快照;强烈建议设置强随机值) ----
ADMIN_API_KEY=

# ---- 报警(泊松触发时 POST 到此 URL,如企业微信机器人) ----
ALERT_WEBHOOK_URL=

# ---- IndexNow(新页上线通知搜索引擎;scripts/indexnow.py gen-key 生成) ----
INDEXNOW_KEY=

# ---- 实验定价(种子实验:单首四档价;需要停用时把层配置删掉) ----
# 无需环境变量,配置存于 .data/db.json 的 config 键,管理 API 可改
